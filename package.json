{
  "name": "decky-dns-unblock",
  "version": "0.2.0",
  "description": "Decky Loader plugin that bypasses ISP DNS blocking on the Steam Deck using encrypted DNS (DoH) with safe fallbacks",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python -m unittest discover -s tests -t ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ch1mpleo/decky-dns-unblock.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "dns",
    "doh"
  ],
  "author": "Ch1mpleo",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Ch1mpleo/decky-dns-unblock/issues"
  },
  "homepage": "https://github.com/Ch1mpleo/decky-dns-unblock#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
